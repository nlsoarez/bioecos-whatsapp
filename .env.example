NODE_ENV=development
PORT=3000
LOG_LEVEL=info
ADMIN_CORS_ORIGINS=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password
DASHBOARD_SESSION_SECRET=change-this-session-secret-32-chars
DASHBOARD_SESSION_TTL_MINUTES=480
RUNTIME_SECRETS_PATH=./data/runtime-secrets.json
DATABASE_URL=postgresql://bioecos:bioecos@localhost:5432/bioecos
DATABASE_SSL=false

BIOECOS_SITE_URL=https://www.bioecoscursos.com.br/
INTEGRAL_GIFT_ENABLED=false
AUTOMATION_TIMEZONE=America/Sao_Paulo
AUTOMATION_START_HOUR=0
AUTOMATION_END_HOUR=24
AUTOMATION_MODE=ai-first
FOLLOWUP_WORKER_INTERVAL_MS=300000

AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PUBLIC_API_URL=
DASHBOARD_PUBLIC_URL=https://nlsoarez.github.io/bioecos-whatsapp/

EVOLUTION_API_VERSION=2
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=bioecos
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_REQUEST_TIMEOUT_MS=10000
EVOLUTION_MAX_RETRIES=3

ADMIN_API_KEY=change-this-admin-key
PII_ENCRYPTION_KEY=
